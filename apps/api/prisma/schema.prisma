generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_CUSTOMER_APPROVAL
  CUSTOMER_APPROVED
  CUSTOMER_DECLINED
  UNDER_REPAIR
  READY_FOR_DELIVERY
  READY_FOR_RETURN_WITHOUT_REPAIR
  DELIVERED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  QUEUED
  PROCESSING
  SENT
  COMPLETED
  FAILED
}

enum PaymentKind {
  DEPOSIT
  COLLECTION
  REFUND
  REVERSAL
}

enum PaymentMethod {
  CASH
  VODAFONE_CASH
  INSTAPAY
  CARD
  BANK_TRANSFER
  OTHER
}

enum CashTransactionType {
  DEPOSIT
  COLLECTION
  MANUAL_INCOME
  EXPENSE
  REFUND
  REVERSAL
}

enum CashDirection {
  IN
  OUT
}

enum CashShiftStatus {
  OPEN
  CLOSED
  APPROVED
}

enum UnlockKind {
  PIN
  PATTERN
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuoteDecisionType {
  APPROVED
  REJECTED
}

enum RepairNoteType {
  DIAGNOSTIC
  INTERNAL
}

model Tenant {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                 @unique
  phone                  String?
  whatsapp               String?
  address                String?
  governorate            String?
  city                   String?
  notes                  String?
  logoUrl                String?
  primaryColor           String                 @default("#0f766e")
  receiptFooter          String?
  receiptPaperWidth      String                 @default("80mm")
  thermalPrinterSettings Json?
  labelPrinterSettings   Json?
  whatsappSettings       Json?
  workflowSettings       Json?
  messageTemplates       Json?
  timezone               String                 @default("Africa/Cairo")
  currency               String                 @default("EGP")
  defaultWarrantyDays    Int                    @default(30)
  onboardingCompletedAt  DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  branches               Branch[]
  users                  User[]
  roles                  Role[]
  customers              Customer[]
  brands                 DeviceBrand[]
  faultPresets           FaultPreset[]
  repairOrders           RepairOrder[]
  subscriptions          Subscription[]
  auditLogs              AuditLog[]
  systemEvents           SystemEvent[]
  whatsappWebhookEvents  WhatsappWebhookEvent[]
  cashShifts             CashShift[]
  cashTransactions       CashTransaction[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  workstations           Workstation[]
}

model Branch {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  code             String
  address          String?
  phone            String?
  whatsapp         String?
  isPrimary        Boolean           @default(false)
  isActive         Boolean           @default(true)
  users            User[]
  repairs          RepairOrder[]
  systemEvents     SystemEvent[]
  cashShifts       CashShift[]
  cashTransactions CashTransaction[]
  expenses         Expense[]
  workstations     Workstation[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId              String?               @db.Uuid
  branch                Branch?               @relation(fields: [branchId], references: [id])
  name                  String
  email                 String
  username              String?
  phone                 String?
  whatsapp              String?
  passwordHash          String
  isActive              Boolean               @default(true)
  roles                 UserRole[]
  createdRepairs        RepairOrder[]         @relation("CreatedBy")
  statusChanges         RepairStatusHistory[]
  auditLogs             AuditLog[]
  createdQuotes         RepairQuote[]         @relation("QuoteCreatedBy")
  repairNotes           RepairNote[]
  technicianAssignments RepairAssignment[]    @relation("AssignedTechnician")
  createdAssignments    RepairAssignment[]    @relation("AssignedBy")
  createdPayments       Payment[]             @relation("PaymentCreatedBy")
  openedCashShifts      CashShift[]           @relation("CashShiftOpenedBy")
  closedCashShifts      CashShift[]           @relation("CashShiftClosedBy")
  approvedCashShifts    CashShift[]           @relation("CashShiftApprovedBy")
  cashTransactions      CashTransaction[]
  createdExpenses       Expense[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, branchId])
}

model Workstation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  type        String
  defaultPage String   @default("dashboard")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, name])
  @@index([tenantId, branchId, isActive])
}

model OnboardingRequest {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  requestHash    String
  response       Json?
  createdAt      DateTime @default(now())
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Customer {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  phoneNormalized String
  phoneDisplay    String
  whatsappPhone   String?
  isRegular       Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  repairs         RepairOrder[]

  @@unique([tenantId, phoneNormalized])
  @@index([tenantId, name])
}

model DeviceBrand {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  repairs   RepairOrder[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
}

model FaultPreset {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  repairFaults RepairFault[]

  @@unique([tenantId, name])
}

model RepairOrder {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String                @db.Uuid
  branch           Branch                @relation(fields: [branchId], references: [id])
  customerId       String                @db.Uuid
  customer         Customer              @relation(fields: [customerId], references: [id])
  brandId          String                @db.Uuid
  brand            DeviceBrand           @relation(fields: [brandId], references: [id])
  createdById      String                @db.Uuid
  createdBy        User                  @relation("CreatedBy", fields: [createdById], references: [id])
  repairNumber     String
  publicTokenHash  String                @unique
  model            String
  color            String?
  imei             String?
  reportedFault    String
  unlockKind       UnlockKind?
  unlockCiphertext String?
  unlockIv         String?
  unlockAuthTag    String?
  estimatedCost    Decimal               @db.Decimal(12, 2)
  status           RepairStatus          @default(RECEIVED)
  deliveredAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  faults           RepairFault[]
  statusHistory    RepairStatusHistory[]
  payments         Payment[]
  printJobs        PrintJob[]
  whatsappMessages WhatsappMessage[]
  quotes           RepairQuote[]
  notes            RepairNote[]
  assignments      RepairAssignment[]

  @@unique([tenantId, repairNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, createdAt])
}

model RepairFault {
  repairOrderId String      @db.Uuid
  faultPresetId String      @db.Uuid
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  faultPreset   FaultPreset @relation(fields: [faultPresetId], references: [id])

  @@id([repairOrderId, faultPresetId])
}

model RepairStatusHistory {
  id            String        @id @default(uuid()) @db.Uuid
  repairOrderId String        @db.Uuid
  repairOrder   RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  fromStatus    RepairStatus?
  toStatus      RepairStatus
  reason        String?
  changedById   String?       @db.Uuid
  changedBy     User?         @relation(fields: [changedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([repairOrderId, createdAt])
}

model RepairQuote {
  id                String               @id @default(uuid()) @db.Uuid
  repairOrderId     String               @db.Uuid
  repairOrder       RepairOrder          @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  version           Int
  amount            Decimal              @db.Decimal(12, 2)
  diagnosis         String
  customerNote      String?
  status            QuoteStatus          @default(PENDING)
  approvalTokenHash String               @unique
  createdById       String               @db.Uuid
  createdBy         User                 @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime             @default(now())
  decidedAt         DateTime?
  decision          RepairQuoteDecision?

  @@unique([repairOrderId, version])
  @@index([repairOrderId, status, createdAt])
}

model RepairQuoteDecision {
  id            String            @id @default(uuid()) @db.Uuid
  repairQuoteId String            @unique @db.Uuid
  repairQuote   RepairQuote       @relation(fields: [repairQuoteId], references: [id], onDelete: Cascade)
  decision      QuoteDecisionType
  channel       String
  createdAt     DateTime          @default(now())
}

model RepairNote {
  id            String         @id @default(uuid()) @db.Uuid
  repairOrderId String         @db.Uuid
  repairOrder   RepairOrder    @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  authorId      String         @db.Uuid
  author        User           @relation(fields: [authorId], references: [id])
  type          RepairNoteType
  body          String
  createdAt     DateTime       @default(now())

  @@index([repairOrderId, createdAt])
}

model RepairAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  repairOrderId String      @db.Uuid
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  technicianId  String      @db.Uuid
  technician    User        @relation("AssignedTechnician", fields: [technicianId], references: [id])
  assignedById  String      @db.Uuid
  assignedBy    User        @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt    DateTime    @default(now())
  endedAt       DateTime?

  @@index([repairOrderId, endedAt])
  @@index([technicianId, endedAt])
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  repairOrderId     String           @db.Uuid
  repairOrder       RepairOrder      @relation(fields: [repairOrderId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  kind              PaymentKind
  paymentMethod     PaymentMethod    @default(CASH)
  reference         String?
  createdAt         DateTime         @default(now())
  reversedPaymentId String?          @db.Uuid
  createdById       String?          @db.Uuid
  createdBy         User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  cashTransaction   CashTransaction?

  @@index([repairOrderId, createdAt])
}

model PrintJob {
  id            String      @id @default(uuid()) @db.Uuid
  repairOrderId String      @db.Uuid
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  kind          String
  payload       Json
  status        JobStatus   @default(QUEUED)
  attempts      Int         @default(0)
  printerName   String?
  workstationId String?
  failureReason String?
  printedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
  @@index([workstationId, status])
}

model WhatsappMessage {
  id                String      @id @default(uuid()) @db.Uuid
  repairOrderId     String      @db.Uuid
  repairOrder       RepairOrder @relation(fields: [repairOrderId], references: [id])
  tenantId          String      @db.Uuid
  branchId          String      @db.Uuid
  type              String
  recipient         String
  templateKey       String
  variables         Json
  status            JobStatus   @default(QUEUED)
  idempotencyKey    String      @unique
  providerMessageId String?
  attempts          Int         @default(0)
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime    @default(now())

  @@index([tenantId, status, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())

  @@unique([tenantId, key])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  yearlyPrice   Decimal        @db.Decimal(12, 2)
  limits        Json
  subscriptions Subscription[]
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String             @db.Uuid
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus
  billingCycle String
  startsAt     DateTime
  endsAt       DateTime?

  @@index([tenantId, status])
}

model SystemEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type      String
  entityId  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, type, createdAt])
}

model WhatsappWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerEventId String   @unique
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
}

model CashShift {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String            @db.Uuid
  branch         Branch            @relation(fields: [branchId], references: [id])
  openedById     String            @db.Uuid
  openedBy       User              @relation("CashShiftOpenedBy", fields: [openedById], references: [id])
  openingBalance Decimal           @db.Decimal(12, 2)
  openedAt       DateTime          @default(now())
  status         CashShiftStatus   @default(OPEN)
  closedById     String?           @db.Uuid
  closedBy       User?             @relation("CashShiftClosedBy", fields: [closedById], references: [id])
  closedAt       DateTime?
  expectedCash   Decimal?          @db.Decimal(12, 2)
  actualCash     Decimal?          @db.Decimal(12, 2)
  variance       Decimal?          @db.Decimal(12, 2)
  notes          String?
  approvedById   String?           @db.Uuid
  approvedBy     User?             @relation("CashShiftApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  transactions   CashTransaction[]

  @@index([tenantId, branchId, openedAt])
  @@index([tenantId, branchId, status])
}

model CashTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId              String              @db.Uuid
  branch                Branch              @relation(fields: [branchId], references: [id])
  shiftId               String?             @db.Uuid
  shift                 CashShift?          @relation(fields: [shiftId], references: [id])
  employeeId            String              @db.Uuid
  employee              User                @relation(fields: [employeeId], references: [id])
  type                  CashTransactionType
  direction             CashDirection
  amount                Decimal             @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  sourceType            String
  sourceId              String?
  reference             String?
  notes                 String?
  paymentId             String?             @unique @db.Uuid
  payment               Payment?            @relation(fields: [paymentId], references: [id])
  reversedTransactionId String?             @db.Uuid
  reversedTransaction   CashTransaction?    @relation("CashTransactionReversal", fields: [reversedTransactionId], references: [id])
  reversals             CashTransaction[]   @relation("CashTransactionReversal")
  expense               Expense?
  createdAt             DateTime            @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([shiftId, createdAt])
  @@index([sourceType, sourceId])
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Expense {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String          @db.Uuid
  branch            Branch          @relation(fields: [branchId], references: [id])
  categoryId        String          @db.Uuid
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  description       String
  attachmentUrl     String?
  incurredAt        DateTime
  createdById       String          @db.Uuid
  createdBy         User            @relation(fields: [createdById], references: [id])
  cashTransactionId String          @unique @db.Uuid
  cashTransaction   CashTransaction @relation(fields: [cashTransactionId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([tenantId, branchId, incurredAt])
}
