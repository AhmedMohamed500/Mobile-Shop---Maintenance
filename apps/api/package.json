    "fastify": "^5.6.1",
    "fastify-raw-body": "^6.0.1",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "^6.16.3",
